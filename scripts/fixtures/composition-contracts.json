{
  "buttonGroup": {
    "schemaVersion": 2,
    "documentType": "composition-contract",
    "metadata": {
      "componentKey": "web-corp.buttons-group",
      "status": "ready",
      "ownershipSchema": "apollo.artifact-ownership.v2"
    },
    "generated": {
      "component": {
        "name": "ButtonGroup [D]",
        "library": "Web _ Corp Components"
      }
    },
    "manual": {
      "contracts": [
        {
          "id": "buttons-group.composition",
          "match": {
            "hostComponentNames": ["[D] ButtonsGroup", "[M] ButtonsGroup"]
          },
          "select": {
            "nestedComponentNames": ["[D] Button", "[M] Button"],
            "visibility": "visible",
            "order": "document"
          },
          "constraints": [
            {
              "id": "button-count",
              "op": "countBetween",
              "min": 2,
              "max": 4,
              "message": "В ButtonsGroup должно быть от двух до четырёх кнопок"
            },
            {
              "id": "allowed-views",
              "op": "propertyDomain",
              "property": "View",
              "values": ["Primary", "Secondary"],
              "message": "В ButtonsGroup допускаются только View=Primary и View=Secondary"
            },
            {
              "id": "uniform-size",
              "op": "propertyEqualsHost",
              "property": "Size",
              "message": "Размер каждой кнопки должен совпадать с Size группы"
            },
            {
              "id": "primary-position",
              "op": "valuePosition",
              "property": "View",
              "value": "Primary",
              "positions": ["first"],
              "maxCount": 1,
              "replacement": "Secondary",
              "message": "Primary-кнопка необязательна, но может быть только первой"
            },
            {
              "id": "single-icon-position",
              "op": "valuePosition",
              "property": "SingleIcon",
              "value": "True",
              "positions": ["last"],
              "maxCount": 1,
              "replacement": "False",
              "message": "SingleIcon допускается только у последней кнопки и только один раз"
            }
          ]
        }
      ]
    }
  },
